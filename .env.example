# ---------------------------------------------------------------------------
# Copy to .env and fill in. Everything here is read by apps/api (HTTP + worker).
# Values shown are the local `npm run infra:up` defaults.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

# --- Postgres -------------------------------------------------------------
DATABASE_URL=postgresql://zed:zed@localhost:5434/zed?schema=public

# --- Redis / BullMQ -------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Object storage (S3 / Cloudflare R2 / MinIO) --------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zed-assets
S3_ACCESS_KEY_ID=zedminio
S3_SECRET_ACCESS_KEY=zedminio123
# MinIO and R2 need path-style addressing; real AWS S3 does not.
S3_FORCE_PATH_STYLE=true
# Public read base for the `public/` prefix. On R2 this is your r2.dev / custom domain.
S3_PUBLIC_BASE_URL=http://localhost:9000/zed-assets

# --- Payments -------------------------------------------------------------
# Which provider the storefront offers by default: stripe | paypal
DEFAULT_PAYMENT_PROVIDER=stripe

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
# sandbox | live
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=xxx

# --- Shipping -------------------------------------------------------------
# Econt (https://ee.econt.com/services): HTTP Basic.
# Demo credentials below hit the Econt sandbox at demo.econt.com.
ECONT_BASE_URL=https://demo.econt.com/ee/services
ECONT_USERNAME=iasp-dev
ECONT_PASSWORD=1Asp-dev
ECONT_SHIPPING_WEBHOOK_SECRET=dev-econt-webhook-secret

# Speedy (https://api.speedy.bg/v1): credentials travel in the JSON body.
SPEEDY_BASE_URL=https://api.speedy.bg/v1
SPEEDY_USERNAME=xxx
SPEEDY_PASSWORD=xxx
SPEEDY_SERVICE_ID=505
SPEEDY_SHIPPING_WEBHOOK_SECRET=dev-speedy-webhook-secret

# --- Sender / warehouse address used for rate quotes and labels ----------
SENDER_NAME=ProjectZed OOD
SENDER_PHONE=+359888000000
SENDER_EMAIL=fulfillment@projectzed.bg
SENDER_COUNTRY=BG
SENDER_CITY=Plovdiv
SENDER_POST_CODE=4000
SENDER_STREET=bul. Bulgaria
SENDER_STREET_NUM=1

# --- Commerce -------------------------------------------------------------
DEFAULT_CURRENCY=EUR
# Free shipping above this order subtotal, in minor units (0 disables).
FREE_SHIPPING_THRESHOLD_MINOR=20000

# --- Email ----------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="ProjectZed <no-reply@projectzed.bg>"
# Where low-stock alerts and other operational notices are sent.
ADMIN_ALERT_EMAIL=fulfillment@projectzed.bg

# --- Ops ------------------------------------------------------------------
LOG_LEVEL=debug
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Protects the /admin/queues Bull Board dashboard.
ADMIN_QUEUE_DASHBOARD_ENABLED=true

# --- 3D garment generation --------------------------------------------------
# local_bake = bake flat-lay photos into a texture for the avatar's own garment
# mesh (free, self-hosted, under a minute). This is what the fitting room uses:
# it gets correct fit and draping for free because the mesh is the avatar's
# own, at the cost of the garment's silhouette always being the avatar's.
# manual = admin uploads a pre-made GLB.
DEFAULT_GARMENT_GENERATION_PROVIDER=manual
GARMENT_MAX_GLB_BYTES=26214400
GARMENT_MAX_TRIANGLES=150000
GARMENT_MAX_SOURCE_IMAGES=4
GARMENT_MAX_SOURCE_IMAGE_BYTES=15728640

# Used by local_bake (see apps/garment3d-service/README.md). A bake finishes in
# well under a minute; the generous timeout only covers a cold start.
GARMENT3D_SERVICE_URL=http://127.0.0.1:8100
GARMENT3D_SERVICE_TIMEOUT_MS=7200000
